rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Hanya Admin aktif yang terdaftar di koleksi users
    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true;
    }

    // Koleksi users: Pengguna login boleh baca profilnya sendiri; Admin boleh kelola
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow update, delete: if isAdmin();
    }

    // Koleksi categories: Customer anonim & Admin boleh baca; Hanya Admin boleh tulis
    match /categories/{categoryId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Koleksi menus: Customer anonim & Admin boleh baca; Hanya Admin boleh tulis
    match /menus/{menuId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Koleksi settings: Customer anonim & Admin boleh baca; Hanya Admin boleh tulis
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Koleksi counters: Customer boleh membaca dan menulis hanya untuk increment lastNumber
    match /counters/{dateKey} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() &&
        request.resource.data.lastNumber is number &&
        request.resource.data.lastNumber > 0;
    }

    // Koleksi orders
    match /orders/{orderId} {
      // Customer tidak boleh membaca/melihat daftar orders. Hanya admin aktif yang boleh membaca orders.
      allow read: if isAdmin();

      // Customer anonim boleh membuat pesanan dengan validasi data dasar tanpa cek dokumen users
      allow create: if isAuthenticated() &&
        request.resource.data.status == 'BARU' &&
        request.resource.data.customerName is string &&
        request.resource.data.customerName.size() >= 1 &&
        request.resource.data.customerName.size() <= 50 &&
        request.resource.data.tableNumber is string &&
        request.resource.data.tableNumber.size() >= 1 &&
        request.resource.data.items is list &&
        request.resource.data.items.size() >= 1 &&
        request.resource.data.items.size() <= 30 &&
        request.resource.data.totalPrice is number &&
        request.resource.data.totalPrice > 0;

      // Hanya Admin aktif yang boleh mengubah status orders (BARU -> DITERIMA, DITERIMA -> SELESAI, dll)
      allow update: if isAdmin();

      // Dilarang menghapus riwayat order
      allow delete: if false;
    }
  }
}
